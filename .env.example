# ─── GreenGeniusAI Environment Variables ────────────────────────────────────
# Copy this to .env in both /website and /backend. NEVER commit .env to git.

# ── Anthropic (AI Engine) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Polygon.io (Live Market Data) ────────────────────────────────────────────
# Free plan: 5 calls/min. Starter ($29/mo): unlimited.
# Sign up at: https://polygon.io
POLYGON_API_KEY=your_polygon_key

# ── Alpaca Markets (Trade Execution) ─────────────────────────────────────────
# Paper trading first (free). Go live when ready.
# Sign up at: https://alpaca.markets
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER=true   # Change to false for live trading

# ── Stripe (Subscriptions — $8.99/mo) ───────────────────────────────────────
# Sign up at: https://stripe.com
# Create a recurring price of $8.99/month in Stripe Dashboard
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_ID=price_...         # From Stripe Dashboard > Products
STRIPE_WEBHOOK_SECRET=whsec_...   # From Stripe Dashboard > Webhooks

# ── Supabase (Database + Auth) ───────────────────────────────────────────────
# Free tier is enough to start. Sign up at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# ── JWT (Backend Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=generate_a_long_random_string_here

# ── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.greengeniusai.com   # Your backend URL
NODE_ENV=production
